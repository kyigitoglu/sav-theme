{{ 'enquiry-buy.css' | asset_url | stylesheet_tag }}

{%- assign watch_title = product.title -%}
{%- assign watch_handle = product.handle -%}
{%- assign watch_reference = product.metafields.custom.reference | default: '' -%}
{%- assign product_id = product.id | append: '' -%}

<div class="enquiry-buy-trigger">
  <button
    type="button"
    id="enquiry-buy-open"
    class="button button--primary button--full-width"
  >
    {{ block.settings.button_label | default: 'Make an Enquiry' }}
  </button>
</div>

<div class="enquiry-buy-overlay" id="enquiry-buy-overlay" aria-hidden="true"></div>

<div
  class="enquiry-buy-drawer"
  id="enquiry-buy-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="{{ block.settings.drawer_title | default: 'Reserve This Watch' }}"
>
  <div class="enquiry-buy-drawer__header">
    <p class="enquiry-buy-drawer__title">
      {{ block.settings.drawer_title | default: 'Reserve This Watch' }}
    </p>
    <button type="button" class="enquiry-buy-drawer__close" id="enquiry-buy-close" aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 1L17 17M17 1L1 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <div class="enquiry-buy-drawer__product">
    <p class="enquiry-buy-drawer__product-title">{{ watch_title }}</p>
    {%- if watch_reference != '' -%}
      <p class="enquiry-buy-drawer__product-ref">Ref. {{ watch_reference }}</p>
    {%- endif -%}
  </div>

  <div class="enquiry-buy-drawer__body" id="enquiry-buy-body">
    <form id="enquiry-buy-form" novalidate>

      <input type="hidden" name="watch_title" value="{{ watch_title | escape }}">
      <input type="hidden" name="watch_reference" value="{{ watch_reference | escape }}">
      <input type="hidden" name="watch_handle" value="{{ watch_handle | escape }}">
      <input type="hidden" name="product_id" value="{{ product_id | escape }}">
      <input type="hidden" name="product_image_url" value="https:{{ product.featured_image | image_url: width: 800 }}">

      <div class="enquiry-buy-form__field">
        <label class="enquiry-buy-form__label" for="buy-name">
          Name <span aria-hidden="true">*</span>
        </label>
        <input class="enquiry-buy-form__input" type="text" id="buy-name" name="name" required autocomplete="name">
        <span class="enquiry-buy-form__error" data-error="name"></span>
      </div>

      <div class="enquiry-buy-form__field">
        <label class="enquiry-buy-form__label" for="buy-email">
          Email <span aria-hidden="true">*</span>
        </label>
        <input class="enquiry-buy-form__input" type="email" id="buy-email" name="email" required autocomplete="email">
        <span class="enquiry-buy-form__error" data-error="email"></span>
      </div>

      <div class="enquiry-buy-form__field">
        <label class="enquiry-buy-form__label" for="buy-phone">Phone</label>
        <input class="enquiry-buy-form__input" type="tel" id="buy-phone" name="phone" autocomplete="tel">
      </div>

      <div class="enquiry-buy-form__field">
        <label class="enquiry-buy-form__label" for="buy-message">Message</label>
        <textarea class="enquiry-buy-form__input enquiry-buy-form__textarea" id="buy-message" name="message" rows="4"></textarea>
      </div>

      <p class="enquiry-buy-form__error enquiry-buy-form__error--global" id="enquiry-buy-error" hidden></p>

      <button type="submit" class="enquiry-buy-form__submit button button--primary" id="enquiry-buy-submit">
        <span class="enquiry-buy-form__submit-label">{{ block.settings.submit_label | default: 'Send Enquiry' }}</span>
        <span class="enquiry-buy-form__submit-loading" hidden>Sending…</span>
      </button>

    </form>
  </div>

  <div class="enquiry-buy-drawer__success" id="enquiry-buy-success" hidden>
    <div class="enquiry-buy-drawer__success-check">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 10L8 14L16 6" stroke="#111" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <p>{{ block.settings.success_message | default: "Thank you — we'll be in touch shortly." }}</p>
  </div>
</div>

<script>
(function () {
  var API_BASE = {{ block.settings.api_base | json }};

  var openBtn     = document.getElementById('enquiry-buy-open');
  var closeBtn    = document.getElementById('enquiry-buy-close');
  var overlay     = document.getElementById('enquiry-buy-overlay');
  var drawer      = document.getElementById('enquiry-buy-drawer');
  var form        = document.getElementById('enquiry-buy-form');
  var submitBtn   = document.getElementById('enquiry-buy-submit');
  var errorGlobal = document.getElementById('enquiry-buy-error');
  var successEl   = document.getElementById('enquiry-buy-success');
  var bodyEl      = document.getElementById('enquiry-buy-body');

  function openDrawer() {
    drawer.classList.add('is-open');
    overlay.classList.add('is-open');
    overlay.removeAttribute('aria-hidden');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function closeDrawer() {
    drawer.classList.remove('is-open');
    overlay.classList.remove('is-open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    openBtn.focus();
  }

  openBtn.addEventListener('click', openDrawer);
  closeBtn.addEventListener('click', closeDrawer);
  overlay.addEventListener('click', closeDrawer);

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && drawer.classList.contains('is-open')) closeDrawer();
  });

  function getField(name) {
    return form.querySelector('[name="' + name + '"]');
  }

  function clearErrors() {
    form.querySelectorAll('[data-error]').forEach(function (el) { el.textContent = ''; });
    errorGlobal.hidden = true;
  }

  function showError(field, msg) {
    var el = form.querySelector('[data-error="' + field + '"]');
    if (el) el.textContent = msg;
  }

  function validate() {
    var ok = true;
    if (getField('name').value.trim().length < 2) { showError('name', 'Name required'); ok = false; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(getField('email').value.trim())) {
      showError('email', 'Valid email required');
      ok = false;
    }
    return ok;
  }

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    clearErrors();
    if (!validate()) return;

    submitBtn.querySelector('.enquiry-buy-form__submit-label').hidden = true;
    submitBtn.querySelector('.enquiry-buy-form__submit-loading').hidden = false;
    submitBtn.disabled = true;

    try {
      var payload = {
        name:              getField('name').value.trim(),
        email:             getField('email').value.trim(),
        phone:             getField('phone').value.trim(),
        message:           getField('message').value.trim(),
        watch_title:       getField('watch_title').value,
        watch_reference:   getField('watch_reference').value,
        watch_handle:      getField('watch_handle').value,
        product_id:        getField('product_id').value,
        product_image_url: getField('product_image_url').value,
        source_url:        window.location.href
      };

      var res = await fetch(API_BASE + '/api/enquiry/buy', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!res.ok) {
        var body = await res.json().catch(function () { return {}; });
        throw new Error(body.error || 'Submission failed');
      }

      bodyEl.hidden = true;
      successEl.hidden = false;
      setTimeout(closeDrawer, 2000);

    } catch (err) {
      errorGlobal.textContent = err.message || 'Something went wrong. Please try again.';
      errorGlobal.hidden = false;
      submitBtn.querySelector('.enquiry-buy-form__submit-label').hidden = false;
      submitBtn.querySelector('.enquiry-buy-form__submit-loading').hidden = true;
      submitBtn.disabled = false;
    }
  });
})();
</script>
